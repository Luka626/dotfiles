#!/bin/bash
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# ------------------------------------------------------
# LOGGING & UTILITIES
# ------------------------------------------------------

echo_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

echo_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

echo_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

execute() {
    local cmd_str="$*"
    local temp_log=$(mktemp)

    if "$@" > "$temp_log" 2>&1; then
        rm "$temp_log"
        return 0
    else
        echo_error "Command failed: $cmd_str"
        echo -e "${YELLOW}--- Error Output ---${NC}"
        cat "$temp_log"
        echo -e "${YELLOW}--------------------${NC}"
        rm "$temp_log"
        exit 1
    fi
}

install_package() {
    local package=$1
    echo_info "Installing $package..."
    execute sudo apt-get update -qq
    execute sudo apt-get install -y "$package"
}

check_and_install() {
    local cmd_name=$1
    local package_name=${2:-$1}

    if command -v "$cmd_name" &> /dev/null; then
        echo_info "$cmd_name is already installed ✓"
        return 0
    else
        echo_warn "$cmd_name not found (package: $package_name)"
        install_package "$package_name"
    fi
}

clone_dotfiles() {
    if [  -d "$PATH_TO_DOTFILES" ]; then
        echo_info "dotfiles already cloned ✓"
        cd "$PATH_TO_DOTFILES"
        execute git fetch
        execute git pull
    else
        echo_info "Cloning dotfiles..."
        execute git clone https://github.com/Luka626/dotfiles.git "$PATH_TO_DOTFILES"
    fi
}

# ------------------------------------------------------
# MAIN
# ------------------------------------------------------

main() {
    OMZ_DIRECTORY="$HOME/.oh-my-zsh"
    PATH_TO_DOTFILES="$HOME/dotfiles"
    ZSH_CUSTOM="$OMZ_DIRECTORY/custom"

    execute sudo apt update -y
    execute sudo apt upgrade -y

    if dpkg -l | grep -q "fzf"; then
        execute sudo apt remove -y fzf
    fi

    PACKAGES=(
        "curl:curl" "git:git" "stow:stow" "tmux:tmux"
        "npm:npm" "zsh:zsh" "make:build-essential"
        "rg:ripgrep" "fdfind:fd-find" "unzip:unzip" "wget:wget"
    )

    if [ "$(systemctl get-default)" = "graphical.target" ]; then
        PACKAGES+=( "kitty:kitty" )
    fi

    for entry in "${PACKAGES[@]}"; do
        cmd="${entry%%:*}"
        pkg="${entry##*:}"
        check_and_install "$cmd" "$pkg"
    done

    mkdir -p "$HOME/.local/bin"
    if command -v fdfind &> /dev/null; then
        ln -sf "$(which fdfind)" "$HOME/.local/bin/fd"
    fi

    if [ "$SHELL" != "$(which zsh)" ]; then
        execute sudo usermod -s $(which zsh) $USER
    fi

    if [ ! -d "$OMZ_DIRECTORY" ]; then
        execute git clone https://github.com/ohmyzsh/ohmyzsh.git "$OMZ_DIRECTORY"
    fi

    if [ -L "$ZSH_CUSTOM" ]; then rm "$ZSH_CUSTOM"; fi
    mkdir -p "$ZSH_CUSTOM/plugins"
    mkdir -p "$ZSH_CUSTOM/themes"

    declare -A plugins=(
        ["zsh-autosuggestions"]="https://github.com/zsh-users/zsh-autosuggestions"
        ["fast-syntax-highlighting"]="https://github.com/zdharma-continuum/fast-syntax-highlighting.git"
    )

    for plugin in "${!plugins[@]}"; do
        if [ ! -d "$ZSH_CUSTOM/plugins/$plugin" ]; then
            execute git clone "${plugins[$plugin]}" "$ZSH_CUSTOM/plugins/$plugin"
        fi
    done

    if [ ! -d "$HOME/.fzf" ]; then
        execute git clone --depth 1 https://github.com/junegunn/fzf.git ~/.fzf
        execute ~/.fzf/install --all
    fi

    if ! command -v rustup &> /dev/null; then
        execute bash -c "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y"
    fi

    source "$HOME/.cargo/env"

    if ! command -v bob &> /dev/null; then
        execute cargo install --git https://github.com/MordechaiHadad/bob.git
    fi

    export PATH="$HOME/.local/share/bob/nvim-bin:$PATH"
    execute bob use latest

    clone_dotfiles

    if [ -f "$HOME/.local/bin/fd" ] && [ ! -L "$HOME/.local/bin/fd" ]; then
        rm -f "$HOME/.local/bin/fd"
        ln -sf "$(which fdfind)" "$HOME/.local/bin/fd"
    fi

    INSTALL_SCRIPT="$PATH_TO_DOTFILES/local/.local/bin/dotfiles-install"
    if [ -f "$INSTALL_SCRIPT" ]; then
        execute bash "$INSTALL_SCRIPT"
    fi

    execute sudo apt autoremove -y
    execute sudo apt autoclean -y
}

main "$@"

#!/usr/bin/env bash

set -e

exec 3>&1
exec 1> /dev/null 2>&1

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo_info() {
    echo -e "${GREEN}[INFO]${NC} $1" >&3
}

echo_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1" >&3
}

echo_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&3
}

install_package() {
    local package=$1
    echo_info "Installing $package..."
    sudo apt-get update && sudo apt-get install -y "$package"
}

check_and_install() {
    local cmd=$1

    if command -v "$cmd" &> /dev/null; then
        echo_info "$cmd is already installed ✓"
        return 0
    else
        echo_warn "$cmd not found"
        install_package "$cmd"
    fi
}

clone_dotfiles() {
    if [  -d "$PATH_TO_DOTFILES" ]; then
        echo_info "dotfiles already cloned ✓"
        cd $PATH_TO_DOTFILES
        git fetch && git pull
    else
        git clone git@github.com:Luka626/dotfiles.git $PATH_TO_DOTFILES
    fi
}

main() {
    OMZ_DIRECTORY="$HOME/.oh-my-zsh"
    PATH_TO_DOTFILES="$HOME/dotfiles"
    ESSENTIAL_PACKAGES=( "curl" "git" "stow" "tmux" "npm" "zsh" "build-essential" "ripgrep" "fd-find" "unzip" "wget" )
    if [ "$(systemctl get-default)" = "graphical.target" ]; then
        echo_info "Graphical system detected. Adding desktop packages..."
        ESSENTIAL_PACKAGES+=( "kitty" )
    else
        echo_info "Headless system detected. Skipping GUI packages."
    fi
 
    echo_info "--- Starting system setup ---"
    echo ""


    echo_info "--- Updating system packages ---"

    echo_info "--- Updating system packages ---"
    sudo apt update -y && sudo apt upgrade -y 

    echo_info "--- Installing essential debian packages ---"
    for package in "${ESSENTIAL_PACKAGES[@]}"; do
        echo_info "Installing: $package"
        check_and_install $package
    done

    # clone repo and install

    # oh-my-zsh
    echo_info "--- Installing oh-my-zsh ---"
    sudo usermod -s $(which zsh) $USER

    if [ -d "$OMZ_DIRECTORY" ]; then
        echo_info "oh-my-zsh already cloned ✓"
    else
        git clone https://github.com/ohmyzsh/ohmyzsh.git ~/.oh-my-zsh
    fi

echo_info "--- Installing ZSH plugins ---"
    ZSH_CUSTOM="$HOME/.oh-my-zsh/custom"
    
    declare -A plugins=(
        ["zsh-autosuggestions"]="https://github.com/zsh-users/zsh-autosuggestions"
        ["zsh-syntax-highlighting"]="https://github.com/zsh-users/zsh-syntax-highlighting.git"
        ["fast-syntax-highlighting"]="https://github.com/zdharma-continuum/fast-syntax-highlighting.git"
        ["zsh-autocomplete"]="https://github.com/marlonrichert/zsh-autocomplete.git"
    )

    for plugin in "${!plugins[@]}"; do
        if [ -d "$ZSH_CUSTOM/plugins/$plugin" ]; then
            echo_info "Plugin $plugin already installed ✓"
        else
            echo_info "Cloning $plugin..."
            git clone "${plugins[$plugin]}" "$ZSH_CUSTOM/plugins/$plugin"
        fi
    done

    echo_info "--- Installing FZF (The Right Way) ---"
    if [ -d "$HOME/.fzf" ]; then
        echo_info "FZF already cloned ✓"
    else
        echo_info "Cloning FZF..."
        git clone --depth 1 https://github.com/junegunn/fzf.git ~/.fzf
        echo_info "Running FZF install script..."
        # This generates the ~/.fzf.zsh file your config needs
        ~/.fzf/install --all
    fi

    echo_info "--- Installing nvim ---"
    echo_info "Installing rustup..."
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    source "$HOME/.cargo/env"
    echo_info "Installing bob-nvim..."
    cargo install --git https://github.com/MordechaiHadad/bob.git
    echo_info "Installing latest nvim..."
    bob use latest


    echo_info "Cloning dotfiles repo..."
    clone_dotfiles

    echo ""
    echo_info "--- System setup complete! ---"

    echo_info "--- Installing dotfiles ---"
    bash $PATH_TO_DOTFILES/local/.local/bin/dotfiles-install
    
    sudo apt autoremove -y && sudo apt autoclean -y
}

main "$@"

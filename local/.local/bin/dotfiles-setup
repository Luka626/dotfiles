#!/bin/bash
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# ------------------------------------------------------
# LOGGING & UTILITIES
# ------------------------------------------------------

echo_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

echo_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

echo_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

execute() {
    local cmd_str="$*"
    local temp_log=$(mktemp)

    if "$@" > "$temp_log" 2>&1; then
        rm "$temp_log"
        return 0
    else
        echo_error "Command failed: $cmd_str"
        echo -e "${YELLOW}--- Error Output ---${NC}"
        cat "$temp_log"
        echo -e "${YELLOW}--------------------${NC}"
        rm "$temp_log"
        exit 1
    fi
}

install_package() {
    local package=$1
    echo_info "Installing $package..."
    execute sudo apt-get update -qq
    execute sudo apt-get install -y "$package"
}

check_and_install() {
    local cmd_name=$1
    local package_name=${2:-$1}

    if command -v "$cmd_name" &> /dev/null; then
        echo_info "$cmd_name is already installed ✓"
        return 0
    else
        echo_warn "$cmd_name not found (package: $package_name)"
        install_package "$package_name"
    fi
}

clone_dotfiles() {
    if [  -d "$PATH_TO_DOTFILES" ]; then
        echo_info "dotfiles already cloned ✓"
        cd "$PATH_TO_DOTFILES"
        execute git fetch 
        execute git pull
    else
        echo_info "Cloning dotfiles..."
        execute git clone https://github.com/Luka626/dotfiles.git "$PATH_TO_DOTFILES"
    fi
}

# ------------------------------------------------------
# MAIN
# ------------------------------------------------------

main() {
    OMZ_DIRECTORY="$HOME/.oh-my-zsh"
    PATH_TO_DOTFILES="$HOME/dotfiles"
    
    echo_info "--- Starting system setup ---"

    echo_info "--- Updating system packages ---"
    execute sudo apt update -y 
    execute sudo apt upgrade -y 

    if dpkg -l | grep -q "fzf"; then
        echo_info "Removing system fzf to prefer the git version..."
        execute sudo apt remove -y fzf
    fi

    echo_info "--- Installing essential debian packages ---"
    PACKAGES=( 
        "curl:curl" 
        "git:git" 
        "stow:stow" 
        "tmux:tmux" 
        "npm:npm" 
        "zsh:zsh" 
        "make:build-essential" 
        "rg:ripgrep" 
        "fdfind:fd-find" 
        "unzip:unzip" 
        "wget:wget" 
    )

    if [ "$(systemctl get-default)" = "graphical.target" ]; then
        echo_info "Graphical system detected. Adding desktop packages..."
        PACKAGES+=( "kitty:kitty" )
    fi

    for entry in "${PACKAGES[@]}"; do
        cmd="${entry%%:*}"
        pkg="${entry##*:}"
        check_and_install "$cmd" "$pkg"
    done

    if command -v fdfind &> /dev/null && ! command -v fd &> /dev/null; then
        echo_info "Symlinking fdfind to fd..."
        mkdir -p ~/.local/bin
        ln -s $(which fdfind) ~/.local/bin/fd
    fi

    echo_info "--- Installing oh-my-zsh ---"
    if [ "$SHELL" != "$(which zsh)" ]; then
        echo_info "Changing default shell to zsh..."
        execute sudo usermod -s $(which zsh) $USER
    fi

    if [ -d "$OMZ_DIRECTORY" ]; then
        echo_info "oh-my-zsh already cloned ✓"
    else
        execute git clone https://github.com/ohmyzsh/ohmyzsh.git "$OMZ_DIRECTORY"
    fi

    echo_info "--- Installing ZSH plugins ---"
    ZSH_CUSTOM="$OMZ_DIRECTORY/custom"
    
    declare -A plugins=(
        ["zsh-autosuggestions"]="https://github.com/zsh-users/zsh-autosuggestions"
        ["zsh-syntax-highlighting"]="https://github.com/zsh-users/zsh-syntax-highlighting.git"
        ["fast-syntax-highlighting"]="https://github.com/zdharma-continuum/fast-syntax-highlighting.git"
        ["zsh-autocomplete"]="https://github.com/marlonrichert/zsh-autocomplete.git"
    )

    for plugin in "${!plugins[@]}"; do
        if [ -d "$ZSH_CUSTOM/plugins/$plugin" ]; then
            echo_info "Plugin $plugin already installed ✓"
        else
            echo_info "Cloning $plugin..."
            rm -rf "$ZSH_CUSTOM/plugins/$plugin"
            execute git clone "${plugins[$plugin]}" "$ZSH_CUSTOM/plugins/$plugin"
        fi
    done

    echo_info "--- Installing fzf ---"
    if [ -d "$HOME/.fzf" ]; then
        echo_info "FZF already cloned ✓"
    else
        echo_info "Cloning FZF..."
        execute git clone --depth 1 https://github.com/junegunn/fzf.git ~/.fzf
        echo_info "Running FZF install script..."
        execute ~/.fzf/install --all
    fi

    echo_info "--- Installing nvim ---"
    if command -v rustup &> /dev/null; then
        echo_info "Rustup already installed ✓"
    else
        echo_info "Installing rustup..."
        execute bash -c "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y"
    fi
    
    source "$HOME/.cargo/env"
    
    if command -v bob &> /dev/null; then
        echo_info "Bob already installed ✓"
    else
        echo_info "Installing bob-nvim..."
        execute cargo install --git https://github.com/MordechaiHadad/bob.git
    fi
    
    echo_info "Installing latest nvim..."
    execute bob use latest

    echo_info "Cloning dotfiles repo..."
    clone_dotfiles

    echo_info "--- System setup complete! ---"

    echo_info "--- Installing dotfiles ---"
    INSTALL_SCRIPT="$PATH_TO_DOTFILES/local/.local/bin/dotfiles-install"
    
    if [ -f "$INSTALL_SCRIPT" ]; then
        execute bash "$INSTALL_SCRIPT"
    else
        echo_warn "Dotfiles install script not found at $INSTALL_SCRIPT"
    fi
    
    execute sudo apt autoremove -y 
    execute sudo apt autoclean -y
}

main "$@"

#!/bin/bash
set -e

# REMOVED: global silencing. We need to see errors when they happen.
# exec 3>&1
# exec 1> /dev/null 2>&1

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

echo_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

echo_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

install_package() {
    local package=$1
    echo_info "Installing $package..."
    sudo apt-get update -qq && sudo apt-get install -y "$package"
}

# Improved to handle cases where Package Name != Command Name
check_and_install() {
    local cmd_name=$1
    local package_name=${2:-$1} # Default to cmd_name if package_name not provided

    if command -v "$cmd_name" &> /dev/null; then
        echo_info "$cmd_name is already installed ✓"
        return 0
    else
        echo_warn "$cmd_name not found (package: $package_name)"
        install_package "$package_name"
    fi
}

clone_dotfiles() {
    if [  -d "$PATH_TO_DOTFILES" ]; then
        echo_info "dotfiles already cloned ✓"
        cd "$PATH_TO_DOTFILES"
        git fetch && git pull
    else
        echo_info "Cloning dotfiles..."
        # Added error handling specifically for this git operation
        if ! git clone git@github.com:Luka626/dotfiles.git "$PATH_TO_DOTFILES"; then
             echo_error "Failed to clone dotfiles. Check your SSH keys or internet connection."
             exit 1
        fi
    fi
}

main() {
    OMZ_DIRECTORY="$HOME/.oh-my-zsh"
    PATH_TO_DOTFILES="$HOME/dotfiles"
    
    # 1. Setup base Utils
    echo_info "--- Starting system setup ---"
    
    echo_info "--- Updating system packages ---"
    sudo apt update -y && sudo apt upgrade -y 

    echo_info "--- Installing essential debian packages ---"
    
    # Format: "command_name:package_name"
    # Note: build-essential has no command, so we handle it separately or assume 'make'
    PACKAGES=( 
        "curl:curl" 
        "git:git" 
        "stow:stow" 
        "tmux:tmux" 
        "npm:npm" 
        "zsh:zsh" 
        "make:build-essential" 
        "rg:ripgrep" 
        "fdfind:fd-find" 
        "unzip:unzip" 
        "wget:wget" 
    )

    if [ "$(systemctl get-default)" = "graphical.target" ]; then
        echo_info "Graphical system detected. Adding desktop packages..."
        PACKAGES+=( "kitty:kitty" )
    fi

    for entry in "${PACKAGES[@]}"; do
        cmd="${entry%%:*}"
        pkg="${entry##*:}"
        check_and_install "$cmd" "$pkg"
    done

    # Fix for 'fd' on Ubuntu (it installs as fdfind, but terminal usually expects fd)
    if command -v fdfind &> /dev/null && ! command -v fd &> /dev/null; then
        echo_info "Symlinking fdfind to fd..."
        mkdir -p ~/.local/bin
        ln -s $(which fdfind) ~/.local/bin/fd
    fi

    # 2. Oh-My-Zsh
    echo_info "--- Installing oh-my-zsh ---"
    # Only change shell if it's not already zsh
    if [ "$SHELL" != "$(which zsh)" ]; then
        echo_info "Changing default shell to zsh..."
        sudo usermod -s $(which zsh) $USER
    fi

    if [ -d "$OMZ_DIRECTORY" ]; then
        echo_info "oh-my-zsh already cloned ✓"
    else
        git clone https://github.com/ohmyzsh/ohmyzsh.git "$OMZ_DIRECTORY"
    fi

    echo_info "--- Installing ZSH plugins ---"
    ZSH_CUSTOM="$OMZ_DIRECTORY/custom"
    
    declare -A plugins=(
        ["zsh-autosuggestions"]="https://github.com/zsh-users/zsh-autosuggestions"
        ["zsh-syntax-highlighting"]="https://github.com/zsh-users/zsh-syntax-highlighting.git"
        ["fast-syntax-highlighting"]="https://github.com/zdharma-continuum/fast-syntax-highlighting.git"
        ["zsh-autocomplete"]="https://github.com/marlonrichert/zsh-autocomplete.git"
    )

    for plugin in "${!plugins[@]}"; do
        if [ -d "$ZSH_CUSTOM/plugins/$plugin" ]; then
            echo_info "Plugin $plugin already installed ✓"
        else
            echo_info "Cloning $plugin..."
            # Capture error but don't exit entire script if one plugin fails, just warn
            if ! git clone "${plugins[$plugin]}" "$ZSH_CUSTOM/plugins/$plugin"; then
                echo_error "Failed to clone $plugin"
            fi
        fi
    done

    # 3. FZF
    echo_info "--- Installing FZF (The Right Way) ---"
    if [ -d "$HOME/.fzf" ]; then
        echo_info "FZF already cloned ✓"
    else
        echo_info "Cloning FZF..."
        git clone --depth 1 https://github.com/junegunn/fzf.git ~/.fzf
        echo_info "Running FZF install script..."
        ~/.fzf/install --all
    fi

    # 4. Neovim / Rust
    echo_info "--- Installing nvim ---"
    if command -v rustup &> /dev/null; then
        echo_info "Rustup already installed ✓"
    else
        echo_info "Installing rustup..."
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    fi
    
    source "$HOME/.cargo/env"
    
    if command -v bob &> /dev/null; then
        echo_info "Bob already installed ✓"
    else
        echo_info "Installing bob-nvim..."
        cargo install --git https://github.com/MordechaiHadad/bob.git
    fi
    
    echo_info "Installing latest nvim..."
    bob use latest

    # 5. Dotfiles
    echo_info "Cloning dotfiles repo..."
    clone_dotfiles

    echo ""
    echo_info "--- System setup complete! ---"

    echo_info "--- Installing dotfiles ---"
    INSTALL_SCRIPT="$PATH_TO_DOTFILES/local/.local/bin/dotfiles-install"
    
    if [ -f "$INSTALL_SCRIPT" ]; then
        bash "$INSTALL_SCRIPT"
    else
        echo_warn "Dotfiles install script not found at $INSTALL_SCRIPT"
    fi
    
    sudo apt autoremove -y && sudo apt autoclean -y
}

main "$@"ain "$@"

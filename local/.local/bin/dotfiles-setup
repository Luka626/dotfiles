#!/usr/bin/env bash

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

echo_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

echo_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

install_package() {
    local package=$1
    echo_info "Installing $package..."
    sudo apt-get update && sudo apt-get install -y "$package"
}

check_and_install() {
    local cmd=$1

    if command -v "$cmd" &> /dev/null; then
        echo_info "$cmd is already installed ✓"
        return 0
    else
        echo_warn "$cmd not found"
        install_package "$cmd"
    fi
}

clone_dotfiles() {
    cd ~
    git clone git@github.com:Luka626/dotfiles.git dotfiles
    cd ~/dotfiles
}

main() {
    echo_info "Starting system setup..."
    echo ""

    echo_info "Updating system packages..."
    sudo apt update -y && sudo apt upgrade -y 

    echo_info "Installing essential packages..."
    check_and_install "curl"
    check_and_install "git"
    check_and_install "stow"
    check_and_install "tmux"
    check_and_install "zsh"

    # clone repo and install

    # kitty
    echo_info "Installing kitty..."
    curl -L https://sw.kovidgoyal.net/kitty/installer.sh | sh /dev/stdin

    # oh-my-zsh
    echo_info "Installing oh-my-zsh..."
    sudo usermod -s $(which zsh) $USER
    git clone https://github.com/ohmyzsh/ohmyzsh.git ~/.oh-my-zsh

    echo_info "Installing rustup, bob-nvim, nvim latest..."
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    source "$HOME/.cargo/env"
    cargo install --git https://github.com/MordechaiHadad/bob.git
    bob use latest


    echo_info "Cloning dotfiles repo..."
    clone_dotfiles

    echo ""
    echo_info "System setup complete!"

    echo_info "Installing dotfiles..."
    bash local/.local/bin/dotfiles-install
}

main "$@"

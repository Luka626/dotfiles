#!/usr/bin/env bash

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

echo_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

DOTFILES_DIR="$HOME/dotfiles"

if [ ! -d "$DOTFILES_DIR" ]; then
    echo_warn "Dotfiles directory not found at $DOTFILES_DIR"
    echo_info "Trying to detect dotfiles directory..."

    # Try to find the directory this script is in
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    DOTFILES_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"

    if [ ! -f "$DOTFILES_DIR/README.md" ]; then
        echo_warn "Could not auto-detect dotfiles directory"
        read -p "Enter path to dotfiles directory: " DOTFILES_DIR
    fi
fi

cd "$DOTFILES_DIR"
echo_info "Using dotfiles directory: $DOTFILES_DIR"
echo ""

# Get list of packages (directories that aren't hidden and aren't git/script dirs)
PACKAGES=( $(ls $DOTFILES_DIR -d */ | tr -d "/") )

if [ $# -eq 0 ]; then
    echo_info "Installing all packages..."
    for package in "${PACKAGES[@]}"; do
        if [ -d "$package" ]; then
            echo_info "Stowing $package..."
            stow -v "$package"
        fi
    done
else
    echo_info "Installing specified packages: $*"
    for package in "$@"; do
        if [ -d "$package" ]; then
            echo_info "Stowing $package..."
            stow -v "$package"
        else
            echo_warn "Package '$package' not found, skipping"
        fi
    done
fi

if [ -z "$SSH_CLIENT" ] && [ -n "$DISPLAY" ]; then
    sudo update-alternatives --install /usr/bin/x-terminal-emulator x-terminal-emulator ~/.local/bin/kitty 50
fi


echo ""
echo_info "Dotfiles installation complete!"
echo_info "Scripts are now available in ~/.local/bin/"
